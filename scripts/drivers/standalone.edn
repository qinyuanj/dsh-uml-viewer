{:version 1
 :doc "独立 egui 窗口 driver（dsh-uml-viewer#17，#18 删除 companion 后的唯一启动方式）：
       没有 Herdr、companion 归属记录或邮件队列；改写 diagram.edn 的标题后，
       viewer 会话按热重载节拍重新载入并显示新标题。"
 :steps [{:op :wait-frames :n 3}
         {:op :assert-gui :path [:document :title] :equals "Standalone"
          :message "the first diagram must load at once"}
         {:op :edit :project "diagram.edn" :from "Standalone" :to "Reloaded"}
         {:op :start-timer :as :reload}
         {:op :wait-timer :as :reload :ms 900}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:document :title] :equals "Reloaded"
          :message "the edited diagram must hot-reload in the standalone window"}
         {:op :write :evidence "standalone-pass.txt"
          :text "PASS standalone window; diagram.edn hot-reloaded\n"}
         {:op :quit :code 0}]}
