{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases {:test {:extra-paths ["test"] :main-opts ["-m" "demo.core-test"]}
           :cov {:extra-paths ["test"]
                 :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
                 :main-opts ["-m" "cloverage.coverage" "--src-ns-path" "src" "--test-ns-path" "test" "--output" "target/coverage"]}}}
