#!/bin/sh
# Versioned pre-commit hook. Enable once per clone:
#   git config core.hooksPath .githooks
# Formatting first: it is fast and its failure names the fix.
set -eu
cd "$(git rev-parse --show-toplevel)"
cargo fmt --all -- --check
# Static source rules (well under a second): the Rust process boundary
# (every lint escape is a listed adapter) and LF goldens.
python=
for candidate in python3 python; do
    if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
        python=$candidate
        break
    fi
done
if [ -z "$python" ]; then
    echo 'pre-commit: Python 3.11+ is required (python3 or python on PATH)' >&2
    exit 1
fi
"$python" -I scripts/test_process_boundary.py
"$python" -I scripts/test_line_endings.py
cargo clippy --workspace --all-targets --locked -- -D warnings
