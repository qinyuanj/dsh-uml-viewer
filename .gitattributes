# cmd parses labels and `goto` by byte offset; an LF checkout of a .cmd
# misreads them. Keep the Windows entries CRLF on every host.
*.cmd text eol=crlf
# Goldens, EDN and Rust sources are compared byte for byte (and rustfmt
# writes LF): check them out LF whatever core.autocrlf says
# (scripts/test_line_endings.py). fixtures/ir-bytes keeps its own -text.
*.edn text eol=lf
*.rs text eol=lf
fixtures/** text eol=lf
# sh reads a CR as part of the command; the enabled hook must stay LF.
.githooks/* text eol=lf

# The packaged Sarasa face is binary; never convert its bytes.
*.ttf binary
